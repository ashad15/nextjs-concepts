{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/InfiniteScroll/layout,_N_T_/InfiniteScroll/page,_N_T_/InfiniteScroll"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
