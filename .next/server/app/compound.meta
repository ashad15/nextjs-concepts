{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/compound/layout,_N_T_/compound/page,_N_T_/compound"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/compound/__PAGE__",
    "/compound",
    "/_index",
    "/_head"
  ]
}