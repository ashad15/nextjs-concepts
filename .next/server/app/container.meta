{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/container/layout,_N_T_/container/page,_N_T_/container"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/container/__PAGE__",
    "/container",
    "/_index",
    "/_head"
  ]
}