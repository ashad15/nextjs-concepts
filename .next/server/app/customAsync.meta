{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/customAsync/layout,_N_T_/customAsync/page,_N_T_/customAsync"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/customAsync/__PAGE__",
    "/customAsync",
    "/_index",
    "/_head"
  ]
}