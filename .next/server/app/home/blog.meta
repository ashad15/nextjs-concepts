{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/home/layout,_N_T_/home/blog/layout,_N_T_/home/blog/page,_N_T_/home/blog"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/home/blog/__PAGE__",
    "/home/blog",
    "/home",
    "/_index",
    "/_head"
  ]
}