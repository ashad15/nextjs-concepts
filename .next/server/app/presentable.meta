{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/presentable/layout,_N_T_/presentable/page,_N_T_/presentable"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/presentable/__PAGE__",
    "/presentable",
    "/_index",
    "/_head"
  ]
}