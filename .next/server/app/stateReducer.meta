{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/stateReducer/layout,_N_T_/stateReducer/page,_N_T_/stateReducer"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/stateReducer/__PAGE__",
    "/stateReducer",
    "/_index",
    "/_head"
  ]
}